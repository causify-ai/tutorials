# bitcoin.API.ipynb

from bitcoin_utils import fetch_bitcoin_price, save_to_db, save_to_csv

# Fetch real-time Bitcoin price
price = fetch_bitcoin_price()
print(f"Current BTC Price: ${price}")

# Save to TimescaleDB
df = save_to_db(price, db_host="localhost")  # Use "timescaledb" if 
running in container

# Log to CSV
csv_path = save_to_csv(df)
print(f"Data saved to CSV at: {csv_path}")

