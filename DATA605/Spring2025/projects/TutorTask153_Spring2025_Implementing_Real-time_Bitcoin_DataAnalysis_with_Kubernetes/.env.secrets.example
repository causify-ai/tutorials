# .env.secrets.example
# Copy this file to .env.secrets and fill in your secure values
# DO NOT commit the actual .env.secrets file!

# PostgreSQL credentials
POSTGRES_PASSWORD=change_this_to_a_secure_password

# Grafana credentials
GRAFANA_ADMIN_PASSWORD=change_this_to_a_secure_password

# API keys (if needed in the future)
COINGECKO_API_KEY=leave_blank_if_not_needed