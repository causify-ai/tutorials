    "import os\n",
    "cfg = os.path.expanduser(\"~/.databrickscfg\")\n",
    "print(\"Exists?\", os.path.isfile(cfg))\n",
    "with open(cfg) as f:\n",
    "    print(\"First line:\", f.readline().strip())"
